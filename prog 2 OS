#!/bin/bash
echo "ENTER THE NUMBER:"
read n
fact=1
while [ $n -gt 1 ]
do
 fact=$((fact * n))
 n=$((n - 1))
done
echo "FACTORIAL OF THE GIVEN NUMBER IS $fact"

